{
  "name": "dak-krds",
  "version": "1.0.16",
  "description": "KRDS(Korea Design System, 대한민국 정부 디자인시스템) 기반 React UI 컴포넌트 라이브러리. 공공 웹사이트·전자정부 서비스를 위한 55개 표준 컴포넌트, WCAG 2.1 AA 웹접근성 준수, TypeScript.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.css.mjs",
    "**/*.css.cjs",
    "./dist/index.mjs",
    "./dist/index.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node scripts/build-manifest.mjs",
    "dev": "vite build --watch",
    "dev:test": "cd example && pnpm dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify:dist && pnpm run verify:docs",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "pnpm run build && node scripts/build-agent-assets.mjs && storybook build -o storybook-static",
    "test:visual": "pnpm run build-storybook && playwright test",
    "test:visual:update": "pnpm run build-storybook && playwright test --update-snapshots",
    "test:contrast": "pnpm run build-storybook && playwright test tests/visual/contrast.spec.ts",
    "test:a11y": "pnpm run build-storybook && playwright test tests/visual/accessible-name.spec.ts"
  },
  "keywords": [
    "krds",
    "korea-design-system",
    "대한민국-정부-디자인시스템",
    "정부-디자인시스템",
    "공공-웹사이트",
    "전자정부",
    "웹접근성",
    "accessibility",
    "wcag",
    "wcag-2-1-aa",
    "korea",
    "korean",
    "government",
    "react",
    "react-components",
    "ui",
    "ui-library",
    "component-library",
    "design-system",
    "typescript"
  ],
  "author": "TeamJeff",
